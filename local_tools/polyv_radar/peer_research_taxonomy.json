  "evidence_rules": {
    "price": [
      "价格必须带来源链接、发布日期和发布者身份；没有来源的数字标注为传闻价，不作为结论。",
      "官网价格页、销售口头报价、用户成交价分开标注。",
      "记录计价单位和周期，避免把年费当成月费。"
    ],
    "account": [
      "官方账号通过认证信息或主页官方链接确认，不凭昵称判断。",
      "同名账号先记录再核验，不跨平台合并身份。"
    ],
    "outreach": [
      "私信话术只采用用户公开分享的内容（截图或转述）或用户自有收信材料。",
      "不通过爬虫读取任何人的私信，不采集手机号、微信、邮箱等联系方式。",
      "引用用户分享内容时保留原文链接与日期。"
    ]
